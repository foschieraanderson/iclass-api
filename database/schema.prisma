generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  teacher
  student
}

model User {
  id        String   @id
  name      String
  email     String   @unique
  password  String
  role      Role     @default(student)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
