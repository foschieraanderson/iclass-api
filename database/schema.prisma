generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  teacher
  student
}

model User {
  id              String                 @id
  name            String
  email           String                 @unique
  password        String
  role            Role                   @default(student)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  teachingClasses Class[]                @relation("ClassTeacher")
  enrolledClasses ClassStudent[]
  resetTokens     PasswordResetToken[]
  createdTasks    Task[]
}

model Task {
  id          String    @id
  classId     String
  createdById String
  title       String
  description String?
  fileUrl     String?
  score       Int
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  class       Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id])

  @@index([classId])
}

model PasswordResetToken {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Class {
  id        String         @id
  code      String         @unique
  period    String
  grade     String
  teacherId String
  teacher   User           @relation("ClassTeacher", fields: [teacherId], references: [id])
  students  ClassStudent[]
  tasks     Task[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ClassStudent {
  classId   String
  studentId String
  class     Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User  @relation(fields: [studentId], references: [id])

  @@id([classId, studentId])
}
