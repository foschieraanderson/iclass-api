# Server
PORT=3000
NODE_ENV=development

# Database — PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iclass

# JWT — use a random string with at least 32 characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-secure-random-string-of-at-least-32-characters
